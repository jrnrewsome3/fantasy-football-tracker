# ─── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
JWT_SECRET=change-me-use-a-long-random-secret

# ─── Database (Railway MySQL or any MySQL-compatible URL) ─────────────────────
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://user:password@localhost:3306/fantasy_football
DB_POOL_SIZE=10

# ─── Clerk Auth ───────────────────────────────────────────────────────────────
# From https://dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxx

# Optional: your Clerk user id (user_...) gets the admin role on first login
OWNER_OPEN_ID=

# ─── OpenAI (AI assistant + weekly recap) ─────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxx
OPENAI_API_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini

# ─── Notes ────────────────────────────────────────────────────────────────────
# - Copy to .env for local development: cp .env.example .env
# - Tests run without DATABASE_URL / Clerk / OpenAI
# - ESPN private-league cookies (espnS2 / SWID) are entered in the UI, not here

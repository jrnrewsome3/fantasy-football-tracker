# ─── Application ─────────────────────────────────────────────────────────────
# Public app identifier used by Manus platform (safe to commit as a name, not a secret)
VITE_APP_ID=your-app-id

# ─── Authentication ───────────────────────────────────────────────────────────
# Secret used to sign/verify session JWTs — use a long random string in production
JWT_SECRET=change-me-use-a-long-random-secret

# OAuth provider base URL (Manus built-in)
OAUTH_SERVER_URL=https://your-oauth-server-url

# Manus login portal URL (frontend — used to build the login redirect)
VITE_OAUTH_PORTAL_URL=https://your-oauth-portal-url

# OpenID of the owner/admin account (determines who gets the "admin" role)
OWNER_OPEN_ID=your-owner-open-id

# ─── Database ─────────────────────────────────────────────────────────────────
# MySQL / TiDB connection string
# Format: mysql://user:password@host:port/database
DATABASE_URL=mysql://user:password@localhost:3306/fantasy_football

# ─── Manus Built-in APIs (server-side) ───────────────────────────────────────
# Provided automatically in the Manus runtime; set manually for local dev
BUILT_IN_FORGE_API_URL=https://your-forge-api-url
BUILT_IN_FORGE_API_KEY=your-forge-api-key

# ─── Frontend environment variables (exposed to the browser via Vite) ─────────
# Built-in Forge API URL/key for frontend LLM and Maps proxy calls
VITE_FRONTEND_FORGE_API_URL=https://your-forge-api-url
VITE_FRONTEND_FORGE_API_KEY=your-frontend-forge-api-key

# ─── Test mode ────────────────────────────────────────────────────────────────
# Tests run without a database by default (DATABASE_URL is intentionally unset).
# Set DATABASE_URL above only if you want integration tests to hit a real DB.
# ESPN credentials are NOT required for tests — they are not used in any test.
